{
  "name": "developer-analytics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:component": "vitest run src/test-layers/component",
    "test:feature": "vitest run src/test-layers/feature",
    "test:responsive": "vitest run src/test-layers/responsive",
    "test:api-error": "vitest run src/test-layers/api-error",
    "test:privacy": "vitest run src/test-layers/privacy",
    "test:mobile": "playwright test --config=playwright.mobile.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "@playwright/test": "1.55.0"
  }
}
