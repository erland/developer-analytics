{
  "name": "developer-analytics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:component": "vitest run src/test-layers/component",
    "test:feature": "vitest run src/test-layers/feature",
    "test:responsive": "vitest run src/test-layers/responsive",
    "test:api-error": "vitest run src/test-layers/api-error",
    "test:privacy": "vitest run src/test-layers/privacy",
    "test:mobile": "playwright test --config=playwright.mobile.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "@playwright/test": "1.65.1"
  },
  "packageManager": "npm@11.6.0"
}
