# Release selection
APP_VERSION=1.0.0
WEB_IMAGE=ghcr.io/erland/developer-analytics-web
BACKEND_IMAGE=ghcr.io/erland/developer-analytics-backend

# Shared PostgreSQL
DB_HOST=replace-with-coolify-internal-postgres-host
DB_NAME=developer_analytics
DB_USERNAME=developer_analytics
DB_PASSWORD=replace-with-long-random-password

# Public URL
FRONTEND_URL=https://developer-analytics.apps.isaksson.info/
GITHUB_CALLBACK_URL=https://developer-analytics.apps.isaksson.info/api/auth/github/callback

# GitHub application configuration
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Application credential encryption
# Base64-encoded 32-byte key.
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CREDENTIAL_KEY_VERSION=v1

# Browser session
SESSION_HOURS=8
SESSION_COOKIE_SECURE=true

# Worker
WORKER_ID=worker-1
WORKER_POLL_INTERVAL=2s

# Optional Gemini
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_PRIVATE_DATA_POLICY=PUBLIC_ONLY
